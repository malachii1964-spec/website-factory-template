# FutureDeskAI — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.
# The site builds and runs without these; each feature activates when its keys are set.

# --- Payments (Stripe) -------------------------------------------------------
# Get your keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=

# Webhook signing secret — powers order fulfillment (emails the buyer their
# download). Create at https://dashboard.stripe.com/webhooks and point it at
# https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Site --------------------------------------------------------------------
# Your canonical URL, used for checkout redirects, download links, and SEO.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.futuredeskai.com

# --- Secure downloads --------------------------------------------------------
# A long random string used to sign download links. Generate one with:
#   openssl rand -hex 32
DOWNLOAD_SECRET=

# Where the product files live. Pick ONE:
#   DOWNLOAD_STORAGE_URL — base URL of a PRIVATE bucket (recommended for prod),
#     e.g. an S3/R2/Supabase bucket. Files are named <product-slug>.pdf
#   DOWNLOADS_DIR        — a local directory of <product-slug>.pdf files
#     (defaults to ./private/downloads for self-hosting)
DOWNLOAD_STORAGE_URL=
# DOWNLOADS_DIR=

# --- Email (Resend) — fulfillment + free lead magnet -------------------------
# Get an API key at https://resend.com/api-keys and verify your sending domain.
RESEND_API_KEY=
# The From address (must be on your verified domain).
RESEND_FROM=FutureDeskAI <hello@futuredeskai.com>
# Optional: an audience to collect free-toolkit signups.
# Create at https://resend.com/audiences
RESEND_AUDIENCE_ID=

# --- Database (later — customer dashboard, order history) --------------------
# Postgres on Neon (https://neon.tech) or Supabase (https://supabase.com)
# DATABASE_URL=
