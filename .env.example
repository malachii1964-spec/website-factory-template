# Chautauqua County Courier — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.
# The site builds and runs without these; the request form activates when set.

# --- Site --------------------------------------------------------------------
# Your canonical URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.chautauquacountycourier.com

# --- "Request a Run" form (Resend) -------------------------------------------
# Powers /request → emails each job to your inbox.
# 1) Make a free account at https://resend.com and create an API key.
# 2) Verify your domain (chautauquacountycourier.com) so you can send from it.
RESEND_API_KEY=
# The From address — must be on your verified domain.
RESEND_FROM=Chautauqua County Courier <dispatch@chautauquacountycourier.com>
# Where run requests are delivered (your email — the dispatcher's inbox).
REQUEST_INBOX_EMAIL=

# --- Later: customer dashboard, saved addresses, recurring runs --------------
# Postgres on Neon (https://neon.tech) or Supabase (https://supabase.com)
# DATABASE_URL=
