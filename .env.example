# FutureDeskAI — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.
# The site builds and runs without these; checkout activates once Stripe keys are set.

# --- Payments (Stripe) -------------------------------------------------------
# Get your keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=

# Webhook signing secret for order fulfillment (Stage 2 / dashboard).
# Create at https://dashboard.stripe.com/webhooks — point it at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Site --------------------------------------------------------------------
# Your canonical URL, used for checkout redirects and SEO. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.futuredeskai.com

# --- Email (Stage 2 — delivering downloads & the free toolkit) ---------------
# Get an API key at https://resend.com/api-keys
# RESEND_API_KEY=

# --- Database (Stage 2 — orders, customer dashboard) -------------------------
# Postgres on Neon (https://neon.tech) or Supabase (https://supabase.com)
# DATABASE_URL=
