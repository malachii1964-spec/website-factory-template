# Fill in per project; get keys from links in comments. Copy to .env.local (gitignored).
# The contact form works WITHOUT these (it logs submissions in dev); set them to
# actually deliver email once Mike's domain is verified.

# Transactional email — powers the /contact form
RESEND_API_KEY=            # resend.com/api-keys
CONTACT_TO=hello@mikesnursery.com          # where contact-form messages are delivered
CONTACT_FROM=Mike's Nursery <hello@mikesnursery.com>  # must be a Resend-verified sender/domain

# Public site URL (used for metadata/sitemap canonical links)
NEXT_PUBLIC_SITE_URL=https://mikesnursery.com
