# The brain. Lives in ~/.malachii by default, but never commit one if
# MALACHII_HOME is pointed inside the repo — it is plaintext personal memory.
.malachii/
brain.db
brain.db-*

# LoCoMo dataset — fetched on demand, not vendored (2.8MB, upstream licence)
malachii/bench/data/
