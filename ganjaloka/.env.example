# GANJALOKA — environment variables
# Copy to .env.local (gitignored) and fill in the keys.
# Local development: run `pnpm db:start`, then `pnpm exec supabase status` and
# copy "Publishable" and "Secret" into the two key lines below.

# --- Supabase ---------------------------------------------------------------
# Hosted: https://supabase.com/dashboard/project/_/settings/api-keys
#   NEXT_PUBLIC_SUPABASE_URL             → Project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY → "Publishable key" (sb_publishable_...)
#   SUPABASE_SECRET_KEY                  → "Secret key" (sb_secret_...) SERVER ONLY.
#     Used only for account deletion. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Site -------------------------------------------------------------------
# Canonical URL, no trailing slash. Must match Supabase Auth "Site URL".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Published contact address (required by App Store guideline 1.2). Use your domain.
NEXT_PUBLIC_CONTACT_EMAIL=hello@ganjaloka.com

# --- Video (phase 2) — https://dashboard.mux.com/settings/access-tokens -------
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
