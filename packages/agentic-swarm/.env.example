# @fda/agentic-swarm — environment variables
# Copy to .env.local (gitignored) in this package's directory, or export in your shell.
# `pnpm demo` runs without any of these — missing capabilities fall back to
# clearly-[MOCK]-logged nodes rather than pretending to be live. See README.md.

# --- Model (Anthropic) --------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# Powers triage (claude-haiku-4-5), diagnose (claude-opus-5), and independent
# verification (claude-sonnet-5).
ANTHROPIC_API_KEY=

# --- Sandbox (Docker) ---------------------------------------------------------
# A reachable Docker daemon (`docker info` must succeed) plus the runner image
# built once: `docker build -t swarm-runner:latest src/sandbox/`
# No env var — capability is probed directly, never assumed from a variable.

# --- Optional overrides --------------------------------------------------------
# Non-standard Chromium path (this repo's CI/sandbox environments set this).
# PLAYWRIGHT_EXECUTABLE_PATH=

# Host label recorded on the runtime manifest for audit purposes only — never
# used to grant capability (MALACHII Kernel §6: names don't grant authority).
# MALACHII_HOST=

# pnpm store mounted read-only into the sandbox so dependency installs don't
# need network access inside the container. Defaults to ~/.pnpm-store.
# PNPM_STORE_PATH=
