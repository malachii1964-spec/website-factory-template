# Lake Erie IronRoots — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.
# The site builds and runs without these; each feature activates when its keys are set.

# --- Site --------------------------------------------------------------------
# Your canonical URL, used for checkout redirects, auth cookies, and SEO.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.lakeerieironroots.com

# --- Payments (Stripe) -------------------------------------------------------
# Get your keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=

# Webhook signing secret — powers order records + the CSA welcome email.
# Create at https://dashboard.stripe.com/webhooks and point it at
# https://YOUR-DOMAIN/api/stripe/webhook (events: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# One-time setup in the Stripe dashboard (no env var needed): activate the
# Customer Portal at https://dashboard.stripe.com/settings/billing/portal
# so CSA subscribers can pause/cancel from /account/subscription.

# --- Database (Postgres on Neon) — accounts, order history, CSA -------------
# Create a free project at https://neon.tech, then run `pnpm db:push` once
# this is set to create the tables.
DATABASE_URL=

# A long random secret Better Auth uses to sign sessions. Generate one with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Email (Resend) — order confirmations, CSA welcome, contact form --------
# Get an API key at https://resend.com/api-keys and verify your sending domain.
RESEND_API_KEY=
# The From address (must be on your verified domain).
RESEND_FROM=Lake Erie IronRoots <hello@lakeerieironroots.com>
# Where contact-form messages are delivered.
CONTACT_EMAIL=hello@lakeerieironroots.com
