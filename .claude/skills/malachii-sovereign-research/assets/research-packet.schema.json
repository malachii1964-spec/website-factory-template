{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malachii.local/schemas/research-packet.schema.json",
  "title": "MALACHII Sovereign Research Packet",
  "type": "object",
  "required": ["schema_version", "skill", "objective", "research_mode", "generated_at", "sources", "claims", "contradictions", "limitations", "deliverable", "quality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"const": "malachii-sovereign-research"},
    "research_mode": {"enum": ["live_research", "source_bounded"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "objective": {
      "type": "object",
      "required": ["raw", "normalized", "freshness_required", "success_criteria"],
      "properties": {
        "raw": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1},
        "freshness_required": {"type": "boolean"},
        "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source_class", "authority", "accessed_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^src_[A-Za-z0-9_-]+$"},
          "title": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["primary", "independent_secondary", "specialist", "community", "user_provided"]},
          "authority": {"enum": ["high", "medium", "low"]},
          "url": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": "string"},
          "accessed_at": {"type": "string", "format": "date-time"},
          "lineage_id": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "importance", "status", "evidence", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^clm_[A-Za-z0-9_-]+$"},
          "claim": {"type": "string", "minLength": 1},
          "importance": {"enum": ["critical", "material", "supporting"]},
          "status": {"enum": ["verified", "supported", "disputed", "inference", "unverified"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "source_ids", "resolution", "explanation"],
        "properties": {
          "claim_id": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "resolution": {"enum": ["resolved", "unresolved"]},
          "explanation": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "deliverable": {
      "type": "object",
      "required": ["summary", "recommendations"],
      "properties": {
        "summary": {"type": "string"},
        "recommendations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["accuracy", "verification", "completeness", "intent_alignment", "execution_readiness", "structure", "edge_cases", "floor", "ship_decision"],
      "properties": {
        "accuracy": {"type": "number", "minimum": 1, "maximum": 10},
        "verification": {"type": "number", "minimum": 1, "maximum": 10},
        "completeness": {"type": "number", "minimum": 1, "maximum": 10},
        "intent_alignment": {"type": "number", "minimum": 1, "maximum": 10},
        "execution_readiness": {"type": "number", "minimum": 1, "maximum": 10},
        "structure": {"type": "number", "minimum": 1, "maximum": 10},
        "edge_cases": {"type": "number", "minimum": 1, "maximum": 10},
        "floor": {"type": "number", "minimum": 1, "maximum": 10},
        "ship_decision": {"enum": ["ship", "dont_ship"]}
      }
    }
  },
  "additionalProperties": true
}
