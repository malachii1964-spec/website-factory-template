{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MALACHII Runtime Manifest",
  "type": "object",
  "required": [
    "host",
    "capabilities"
  ],
  "properties": {
    "host": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    }
  }
}